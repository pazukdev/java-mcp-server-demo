<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>

  <!-- Optional: More specific logging level for your application -->
  <!--
  <logger name="com.example.mcp" level="DEBUG" additivity="false">
    <appender-ref ref="STDOUT" />
  </logger>
  -->

</configuration>
